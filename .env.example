# Copy to .env.local for local development. Never commit .env.local.

# --- The AI planner ---------------------------------------------------------
# Server-side only; never sent to the browser. Without it the live AI path is off
# and only the example requests work.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Keeping a public demo private -----------------------------------------
# When set, the page and every /api/paa route require this password (a signed,
# expiring cookie is issued). Leave empty in local development to keep it open.
# Changing the password signs everyone out immediately.
DEMO_PASSWORD=
# How long an unlock lasts, in hours (default 12).
ACCESS_HOURS=
# A ceiling on AI requests per UTC day (default 300). A backstop only: serverless
# instances count separately, so also set a spend limit with your AI provider.
AI_DAILY_CAP=
